# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Flask instance folder (local SQLite DB)
instance/
proam.db
*.db
*.sqlite3

# Uploaded files
uploads/

# Large media files (too big for GitHub; keep locally only)
static/video/

# Environment secrets
.env
.env.*

# OS artifacts
.DS_Store
Thumbs.db

# Distribution
*.egg-info/
*.egg
dist/
build/
.gstack/
.claude/
.compound-engineering/*.local.yaml

# Test / lint / coverage caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# gstack skill artifacts (retros, QA reports, checkpoints — local tooling output)
.context/
.gstack/

# Logs
*.log

# Session handoff paste buffers — generated per session, not source
SESSION_HANDOFF_*.md

# Patch transfer between the Claude session and this checkout.
# _claude_inbox/ holds exactly two files, both overwritten on every delivery:
# patches.mbox (every commit this checkout does not have yet) and apply.bat
# (the one command that applies it). Nothing in there is source.
_claude_inbox/

# Loose patch files dropped in the repo root by that transfer. Root-anchored on
# purpose: phase0_identity_substrate.patch is already tracked and stays tracked,
# and a patch committed deliberately somewhere other than the root still shows.
/*.patch
/*.mbox
